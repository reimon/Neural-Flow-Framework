# scripts/.env — Neural-Flow Framework local configuration
# ⚠️ NUNCA commitar este arquivo. Está no .gitignore.
# Copie de .env.example e preencha com os valores do terraform output.

AZURE_SEARCH_ENDPOINT=https://<search-service-name>.search.windows.net
AZURE_SEARCH_ADMIN_KEY=<admin-key-from-key-vault-or-azure-portal>
AZURE_SEARCH_INDEX_NAME=neural-memory

AZURE_OPENAI_ENDPOINT=https://<openai-resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<openai-api-key-from-key-vault-or-azure-portal>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
